create_clock -period 20.000 -name sys_clk [get_ports sys_clk]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN U18} [get_ports sys_clk]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN N16} [get_ports sys_rst_n]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN V15} [get_ports {ad_data_1[0]}]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN W15} [get_ports {ad_data_1[1]}]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN W14} [get_ports {ad_data_1[2]}]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN Y14} [get_ports {ad_data_1[3]}]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN V12} [get_ports {ad_data_1[4]}]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN W13} [get_ports {ad_data_1[5]}]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN U14} [get_ports {ad_data_1[6]}]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN U15} [get_ports {ad_data_1[7]}]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN V13} [get_ports {ad_data_1[8]}]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN U13} [get_ports {ad_data_1[9]}]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN Y11} [get_ports ad_otr_1]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN Y13} [get_ports ad_clk_1]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN W11} [get_ports ad_oe_1]
# Channel 2 from the original dual ADC pinout.
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN V11} [get_ports {ad_data_2[0]}]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN W10} [get_ports {ad_data_2[2]}]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN Y9} [get_ports {ad_data_2[4]}]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN Y7} [get_ports {ad_data_2[6]}]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN W6} [get_ports {ad_data_2[8]}]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN U10} [get_ports ad_otr_2]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN U9} [get_ports ad_clk_2]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN V10} [get_ports {ad_data_2[1]}]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN W9} [get_ports {ad_data_2[3]}]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN Y8} [get_ports {ad_data_2[5]}]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN Y6} [get_ports {ad_data_2[7]}]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN V6} [get_ports {ad_data_2[9]}]
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN T9} [get_ports {ad_oe_2}]
# Both DAC channels, exactly the original package pins and I/O standard.
set_property PACKAGE_PIN T14 [get_ports {da_data_1[9]}]
set_property PACKAGE_PIN T15 [get_ports {da_data_1[8]}]
set_property PACKAGE_PIN Y17 [get_ports {da_data_1[7]}]
set_property PACKAGE_PIN Y16 [get_ports {da_data_1[6]}]
set_property PACKAGE_PIN T16 [get_ports {da_data_1[5]}]
set_property PACKAGE_PIN U17 [get_ports {da_data_1[4]}]
set_property PACKAGE_PIN V17 [get_ports {da_data_1[3]}]
set_property PACKAGE_PIN V18 [get_ports {da_data_1[2]}]
set_property PACKAGE_PIN T17 [get_ports {da_data_1[1]}]
set_property PACKAGE_PIN R18 [get_ports {da_data_1[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {da_data_1[9]}]
set_property IOSTANDARD LVCMOS33 [get_ports {da_data_1[8]}]
set_property IOSTANDARD LVCMOS33 [get_ports {da_data_1[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {da_data_1[6]}]
set_property IOSTANDARD LVCMOS33 [get_ports {da_data_1[5]}]
set_property IOSTANDARD LVCMOS33 [get_ports {da_data_1[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {da_data_1[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {da_data_1[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {da_data_1[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {da_data_1[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports da_clk_1]
set_property PACKAGE_PIN W16 [get_ports da_clk_1]
set_property PACKAGE_PIN W18 [get_ports {da_data_2[9]}]
set_property PACKAGE_PIN W19 [get_ports {da_data_2[8]}]
set_property PACKAGE_PIN R16 [get_ports {da_data_2[7]}]
set_property PACKAGE_PIN R17 [get_ports {da_data_2[6]}]
set_property PACKAGE_PIN W20 [get_ports {da_data_2[5]}]
set_property PACKAGE_PIN V20 [get_ports {da_data_2[4]}]
set_property PACKAGE_PIN P18 [get_ports {da_data_2[3]}]
set_property PACKAGE_PIN N17 [get_ports {da_data_2[2]}]
set_property PACKAGE_PIN P19 [get_ports {da_data_2[1]}]
set_property PACKAGE_PIN N18 [get_ports {da_data_2[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {da_data_2[9]}]
set_property IOSTANDARD LVCMOS33 [get_ports {da_data_2[8]}]
set_property IOSTANDARD LVCMOS33 [get_ports {da_data_2[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {da_data_2[6]}]
set_property IOSTANDARD LVCMOS33 [get_ports {da_data_2[5]}]
set_property IOSTANDARD LVCMOS33 [get_ports {da_data_2[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {da_data_2[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {da_data_2[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {da_data_2[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {da_data_2[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports da_clk_2]
set_property PACKAGE_PIN P16 [get_ports da_clk_2]
# Only explicit first-stage synchronizers; never exempt the measurement datapath.
set_false_path -to [get_pins -hier -filter {NAME =~ */ctrl_meta_reg*/D}]
set_false_path -to [get_pins -hier -filter {NAME =~ */status_meta_reg*/D}]
set_false_path -to [get_pins -hier -filter {NAME =~ */config_meta_reg*/D}]
set_false_path -to [get_pins -hier -filter {NAME =~ */ack_meta_reg*/D}]
set_false_path -from [get_ports sys_rst_n]
# External ADC input and DAC output delay budgets require the actual converter
# datasheets + PCB/cable timing. Original interfaces had no delay budget.
# Do not interpret passing internal timing as external-interface sign-off.
